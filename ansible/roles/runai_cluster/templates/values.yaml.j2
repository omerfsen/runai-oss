{{ ansible_managed | comment }}
# Run:ai cluster ({{ runai_version }}), chart runai-oss/runai-cluster.
# cluster.uid and the one-time bootstrap token come from registering the
# cluster with the control plane's REST API; the role passes them on stdin
# and never writes them to disk.

controlPlane:
  url: https://{{ runai_fqdn }}
  clientID: runai-internal.installer

cluster:
  url: https://{{ runai_fqdn }}          # same Kubernetes cluster as the control plane

global:
  customCA:
    enabled: true                          # trust the self-signed CA (secret runai-ca-cert)
{% if system_node_selector | length > 0 %}
  # Required, not just preferred (the chart's default): Run:ai's cluster
  # services on the system node, none on the GPU node.
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
{% for key, value in system_node_selector.items() %}
              - {key: "{{ key }}", operator: In, values: ["{{ value }}"]}
{% endfor %}
{% endif %}

clusterConfig:
  global:
    ingress:
      ingressClass: traefik
{% if system_node_selector | length > 0 %}
    nodeAffinity:
      # Workloads only on nodes with a Run:ai worker role: GPU workloads need
      # node-role.kubernetes.io/runai-gpu-worker, CPU-only ones runai-cpu-worker.
      restrictScheduling: true
{% endif %}
{% if system_node_selector | length > 0 %}

# Two cluster-level controllers live in subcharts that do not read
# global.affinity; both landed on the GPU node until pinned here. Their
# per-node DaemonSets (gpu-fractioning's fractiond and mpsd) still run on the
# GPU node, as they must.
karta:
  nodeSelector: {{ system_node_selector | to_json }}
kai-resource-management:
  kai-scheduler:
    gpu-fractioning:
      nodeSelector: {{ system_node_selector | to_json }}
{% endif %}
