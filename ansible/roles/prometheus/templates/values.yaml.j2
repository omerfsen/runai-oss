{{ ansible_managed | comment }}
# kube-prometheus-stack {{ prometheus_stack_version }} for Run:ai (needs 88.6.5+).
# Run:ai creates its own Prometheus instance on top of this operator.

grafana:
  enabled: false        # Run:ai has its own dashboards
alertmanager:
  enabled: false
prometheus:
  prometheusSpec:
    # Pick up ServiceMonitors/PodMonitors from every release, not only this
    # chart's (GPU Operator's DCGM exporter, Run:ai's own components).
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
{% if system_node_selector | length > 0 %}
    nodeSelector: {{ system_node_selector | to_json }}

# Controllers on the system node; node-exporter (a DaemonSet) still covers
# every node, the GPU node included.
prometheusOperator:
  nodeSelector: {{ system_node_selector | to_json }}
  admissionWebhooks:
    patch:
      nodeSelector: {{ system_node_selector | to_json }}
kube-state-metrics:
  nodeSelector: {{ system_node_selector | to_json }}
{% endif %}
